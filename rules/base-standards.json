      "severity": "error",
      "enforcement": {
        "level": "critical",
        "type": "deterministic",
        "verifier": "protected-files"
      },
      "evidence": [
        "changed-files",
        "generation-command"
      ],
      "fix": "Change the source definition and run the configured generator.",
      "exception": {
        "allowed": false,
        "requiresReason": false
      },
      "knowledgeImpact": []
    },
