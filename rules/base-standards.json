      "evidence": [
        "dependency-graph"
      ],
      "fix": "Extract a lower-level module or invert the dependency through an interface.",
      "exception": {
        "allowed": false,
        "requiresReason": false
      },
      "knowledgeImpact": [
        "architecture decision"
      ]
    },
    {
      "schemaVersion": "1.0",
