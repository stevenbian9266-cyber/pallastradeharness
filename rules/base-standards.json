{
  "schemaVersion": "1.0",
  "standards": [
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-SCOPE-001",
      "category": "architecture",
      "title": "Implementation changes must stay inside the approved Change Plan",
      "authority": { "file": "harness change plan", "section": "allow/deny scope" },
      "scope": ["**/*"],
      "severity": "error",
      "enforcement": { "level": "blocking", "type": "deterministic", "verifier": "scope-drift" },
      "evidence": ["changed-files", "change-plan"],
      "fix": "Update the plan after a risk review, or move the change back into the approved scope.",
      "exception": { "allowed": true, "requiresReason": true },
      "knowledgeImpact": []
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-GEN-001",
      "category": "code-quality",
      "title": "Generated files must be changed through their generator",
      "authority": { "file": "harness.config.mjs", "section": "supervisor.generatedFiles" },
      "scope": ["**/*"],
      "severity": "error",
      "enforcement": { "level": "critical", "type": "deterministic", "verifier": "protected-files" },
      "evidence": ["changed-files", "generation-command"],
      "fix": "Change the source definition and run the configured generator.",
      "exception": { "allowed": false, "requiresReason": false },
      "knowledgeImpact": []
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-ARCH-001",
      "category": "architecture",
      "title": "Dependencies must follow declared architecture boundaries",
      "authority": { "file": "harness.config.mjs", "section": "supervisor.boundaries" },
      "scope": ["**/*.{js,mjs,cjs,ts,tsx,jsx}"],
      "severity": "error",
      "enforcement": { "level": "verified", "type": "deterministic", "verifier": "architecture-boundaries" },
      "evidence": ["changed-imports", "boundary-config"],
      "fix": "Use the allowed dependency direction or introduce an explicit adapter.",
      "exception": { "allowed": true, "requiresReason": true },
      "knowledgeImpact": ["architecture decision"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-ARCH-002",
      "category": "architecture",
      "title": "Changed modules must not introduce circular dependencies",
      "authority": { "file": "Harness built-in policy", "section": "Architecture Supervisor" },
      "scope": ["**/*.{js,mjs,cjs,ts,tsx,jsx}"],
      "severity": "error",
      "enforcement": { "level": "verified", "type": "deterministic", "verifier": "dependency-cycles" },
      "evidence": ["dependency-graph"],
      "fix": "Extract a lower-level module or invert the dependency through an interface.",
      "exception": { "allowed": false, "requiresReason": false },
      "knowledgeImpact": ["architecture decision"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-TECH-001",
      "category": "technology-selection",
      "title": "New dependencies require a technology choice review",
      "authority": { "file": "Harness built-in policy", "section": "Technology Choice Supervisor" },
      "scope": ["**/package.json", "**/Gemfile", "**/requirements*.txt"],
      "severity": "warning",
      "enforcement": { "level": "review-required", "type": "deterministic", "verifier": "dependency-additions" },
      "evidence": ["dependency-diff", "technology-review"],
      "fix": "Record alternatives, maintenance/security cost, exit cost, and why existing technology is insufficient.",
      "exception": { "allowed": true, "requiresReason": true },
      "knowledgeImpact": ["architecture decision", "dependency documentation"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-CQ-001",
      "category": "code-quality",
      "title": "New code must stay below the configured decision complexity baseline",
      "authority": { "file": "harness.config.mjs", "section": "supervisor.complexity.maxDecisionPoints" },
      "scope": ["**/*.{js,mjs,cjs,ts,tsx,jsx,rb,py}"],
      "severity": "warning",
      "enforcement": { "level": "verified", "type": "deterministic", "verifier": "new-code-complexity" },
      "evidence": ["added-lines", "decision-count"],
      "fix": "Split responsibilities, use guard clauses, or extract a named unit with focused tests.",
      "exception": { "allowed": true, "requiresReason": true },
      "knowledgeImpact": []
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-CQ-002",
      "category": "code-quality",
      "title": "New code must not duplicate a substantial block",
      "authority": { "file": "harness.config.mjs", "section": "supervisor.complexity.duplicateBlockLines" },
      "scope": ["**/*.{js,mjs,cjs,ts,tsx,jsx,rb,py}"],
      "severity": "warning",
      "enforcement": { "level": "verified", "type": "deterministic", "verifier": "new-code-duplication" },
      "evidence": ["added-lines", "duplicate-block"],
      "fix": "Reuse the existing abstraction or extract the shared behavior once.",
      "exception": { "allowed": true, "requiresReason": true },
      "knowledgeImpact": []
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-DB-001",
      "category": "database",
      "title": "Historical migrations and generated schema snapshots are immutable",
      "authority": { "file": "project agent instructions", "section": "database changes" },
      "scope": ["**/db/migrate/**/*", "**/db/schema.rb"],
      "severity": "error",
      "enforcement": { "level": "critical", "type": "deterministic", "verifier": "historical-migration" },
      "evidence": ["base-tree", "changed-files"],
      "fix": "Create a new reversible migration and regenerate the schema through the framework.",
      "exception": { "allowed": false, "requiresReason": false },
      "knowledgeImpact": ["data model documentation", "recovery plan"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-TEST-001",
      "category": "testing",
      "title": "Behavior changes require objective verification evidence",
      "authority": { "file": "Harness built-in policy", "section": "Verification" },
      "scope": ["**/*"],
      "severity": "error",
      "enforcement": { "level": "review-required", "type": "evidence", "verifier": "verification-evidence" },
      "evidence": ["test-evidence", "build-evidence"],
      "fix": "Run the applicable test/build and attach its command, exit code, commit state, and summary.",
      "exception": { "allowed": true, "requiresReason": true },
      "knowledgeImpact": []
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-KNOW-001",
      "category": "knowledge",
      "title": "Changed behavior must evaluate affected knowledge assets",
      "authority": { "file": "Harness built-in policy", "section": "Knowledge Loop" },
      "scope": ["**/*"],
      "severity": "warning",
      "enforcement": { "level": "review-required", "type": "evidence", "verifier": "knowledge-impact" },
      "evidence": ["knowledge-evidence"],
      "fix": "Record each affected asset as updated, reviewed-no-change, or not-applicable.",
      "exception": { "allowed": false, "requiresReason": false },
      "knowledgeImpact": ["project knowledge index"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-UI-001",
      "category": "ui-style",
      "title": "UI changes should reuse the project's design system and tokens",
      "authority": { "file": "project UI standard", "section": "design system" },
      "scope": ["**/*.{css,scss,tsx,jsx,vue}"],
      "severity": "warning",
      "enforcement": { "level": "documented", "type": "review", "verifier": null },
      "evidence": ["ui-review"],
      "fix": "Reuse existing components, variants, spacing, typography, and color tokens.",
      "exception": { "allowed": true, "requiresReason": true },
      "knowledgeImpact": ["style guide"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-INT-001",
      "category": "interaction",
      "title": "Interactive UI requires state and accessibility review",
      "authority": { "file": "project interaction standard", "section": "state matrix" },
      "scope": ["**/*.{tsx,jsx,vue}"],
      "severity": "warning",
      "enforcement": { "level": "documented", "type": "review", "verifier": null },
      "evidence": ["dom-evidence", "accessibility-evidence"],
      "fix": "Review loading, empty, error, disabled, success, keyboard, focus, and screen-reader states.",
      "exception": { "allowed": true, "requiresReason": true },
      "knowledgeImpact": ["interaction guide"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-API-001",
      "category": "api",
      "title": "API changes require contract compatibility review",
      "authority": { "file": "project API standard", "section": "contracts" },
      "scope": ["**/*api*/**/*", "**/*openapi*", "**/*swagger*"],
      "severity": "warning",
      "enforcement": { "level": "documented", "type": "review", "verifier": null },
      "evidence": ["api-contract-evidence"],
      "fix": "Verify request/response compatibility, generated clients, authorization, and API documentation.",
      "exception": { "allowed": true, "requiresReason": true },
      "knowledgeImpact": ["API documentation"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-SEC-001",
      "category": "security",
      "title": "Security-sensitive changes require a dedicated review",
      "authority": { "file": "project security standard", "section": "security review" },
      "scope": ["**/*auth*", "**/*security*", "**/*permission*", "**/*secret*"],
      "severity": "error",
      "enforcement": { "level": "review-required", "type": "review", "verifier": "security-review" },
      "evidence": ["security-review-evidence"],
      "fix": "Review authentication, authorization, input handling, secrets, tenant isolation, and abuse cases.",
      "exception": { "allowed": false, "requiresReason": false },
      "knowledgeImpact": ["security standard", "threat model"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-A11Y-001",
      "category": "accessibility",
      "title": "Interactive UI requires keyboard, focus, and assistive technology verification",
      "authority": { "file": "project accessibility standard", "section": "interaction accessibility" },
      "scope": ["**/*.{tsx,jsx,vue,html}"],
      "severity": "warning",
      "enforcement": { "level": "documented", "type": "review", "verifier": null },
      "evidence": ["accessibility-evidence"],
      "fix": "Verify semantic roles, labels, keyboard flow, focus restoration, contrast, and screen-reader output.",
      "exception": { "allowed": true, "requiresReason": true },
      "knowledgeImpact": ["accessibility guide"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-DOC-001",
      "category": "documentation",
      "title": "Documentation must remain traceable to code facts",
      "authority": { "file": "project documentation standard", "section": "source of truth" },
      "scope": ["**/*.md", "**/*.mdx"],
      "severity": "warning",
      "enforcement": { "level": "review-required", "type": "evidence", "verifier": "documentation-review" },
      "evidence": ["knowledge-evidence"],
      "fix": "Cite the authoritative code/config source and verify commands, examples, and file references.",
      "exception": { "allowed": true, "requiresReason": true },
      "knowledgeImpact": ["documentation index"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-DEPLOY-001",
      "category": "deployment",
      "title": "Deployment changes require rollback and verification steps",
      "authority": { "file": "project deployment standard", "section": "recovery" },
      "scope": ["**/Dockerfile*", "**/docker-compose*.yml", "**/.github/workflows/*", "**/*deploy*"],
      "severity": "error",
      "enforcement": { "level": "review-required", "type": "review", "verifier": "deployment-review" },
      "evidence": ["deployment-evidence", "rollback-plan"],
      "fix": "Document stop conditions, rollback steps, configuration changes, and post-deploy verification.",
      "exception": { "allowed": false, "requiresReason": false },
      "knowledgeImpact": ["deployment documentation"]
    }
  ]
}
