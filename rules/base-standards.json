{
  "schemaVersion": "1.0",
  "standards": [
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-SCOPE-001",
      "category": "architecture",
      "title": "Implementation changes must stay inside the approved Change Plan",
      "authority": {
        "file": "harness change plan",
        "section": "allow/deny scope"
      },
      "scope": [
        "**/*"
      ],
      "severity": "error",
      "enforcement": {
        "level": "blocking",
        "type": "deterministic",
        "verifier": "scope-drift"
      },
      "evidence": [
        "changed-files",
        "change-plan"
      ],
      "fix": "Update the plan after a risk review, or move the change back into the approved scope.",
      "exception": {
        "allowed": true,
        "requiresReason": true
      },
      "knowledgeImpact": []
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-GEN-001",
