    { "id": "knowledge", "name": "知识与上下文", "layer": "knowledge", "paths": ["bin/project-brain.mjs", "bin/knowledge-loop.mjs", "bin/doc-impact.mjs", "bin/docs-check.mjs", "bin/readme-sync.mjs", "bin/metrics.mjs"], "responsibilities": ["索引/上下文包/文档同步/指标"], "depends_on": ["contracts", "state"] },
    { "id": "integration", "name": "集成与适配", "layer": "integration", "paths": ["bin/mcp.mjs", "bin/hooks.mjs", "bin/hook-agent.mjs", "bin/agent-adapters.mjs", "bin/capability-registry.mjs", "bin/plugins.mjs", "bin/ci.mjs", "bin/init.mjs", "bin/onboard.mjs"], "responsibilities": ["MCP 协议/Agent Hook/插件与适配器/CI 生成"], "depends_on": ["contracts", "state"] }
