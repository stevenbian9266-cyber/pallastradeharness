  "dependency_rules": [
    {
      "id": "ARCH-001",
      "from": "all",
      "rule": "deny self-dependency on the published package",
      "deny": ["pallastrade-harness"],
      "reason": "自引用依赖会加载旧版发布物（Batch A TASK-A02 决策；守卫测试见 bin/version.test.mjs）"
    }
  ],
  "rules": [
    { "id": "ARCH-R1", "severity": "warning", "description": "禁止引入第二套 Task/Gate/Evidence/Skill/Decision 引擎（复用优先：调用已有 → 扩展已有）" },
    { "id": "ARCH-R2", "severity": "warning", "description": "MCP transport 不得自行决定业务 Gate、Task 或最终状态（RFC-0004；工具层只调用域函数）" },
    { "id": "ARCH-R3", "severity": "blocking", "description": "禁止自引用依赖 pallastrade-harness（由 ARCH-001 dependency deny 强制阻断）" },
    { "id": "ARCH-R4", "severity": "warning", "description": "领域逻辑禁止 Cloud 特定分支（if (cloud)）——Cloud 属 Batch D，须经运行时边界" }
  ],
  "layers": [
    { "name": "entry", "direction": "可依赖任意治理域与基础层" },
    { "name": "governance/supervision/verification/knowledge/integration", "direction": "只依赖 contracts/state 与其声明的域" },
    { "name": "base", "direction": "禁止依赖任何上层" }
  ],
  "data_ownership": [
    { "data": "task state", "owner": "task", "readers": ["cli", "evidence", "knowledge"] },
    { "data": "gate state", "owner": "task", "readers": ["cli", "evidence"] },
    { "data": "evidence", "owner": "evidence", "readers": ["cli", "knowledge"] },
    { "data": "constitution artifacts/versions", "owner": "constitution", "readers": ["supervision", "knowledge", "cli"] },
    { "data": "approvals", "owner": "constitution", "readers": ["fact-gates", "cli"] }
  ],
  "known_debt": [
    { "debt": "Core 与 Local I/O（rootDir/fs/git）高耦合", "impact": "Cloud 抽取成本", "plan": "Batch D Repository Ports 增量抽取" },
    { "debt": "Supervisor findings 未持久化关联", "impact": "Blocking Findings 跨流程追溯弱", "plan": "后续批次接入 strict finish 的 blocking 检查" }
  ],
  "related_adr": [
