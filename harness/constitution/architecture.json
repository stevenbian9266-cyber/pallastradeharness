    { "id": "constitution", "name": "Constitution 治理", "layer": "governance", "paths": ["bin/constitution.mjs", "bin/constitution-change.mjs", "bin/project-artifacts.mjs", "bin/approvals.mjs", "bin/fact-gates.mjs", "bin/governance.mjs"], "responsibilities": ["制品/版本/变更流/审批/事实门", "治理画像"], "depends_on": ["contracts", "state"] },
    { "id": "assets", "name": "模板与资产", "layer": "governance", "paths": ["bin/skill.mjs", "bin/skill-template.mjs", "bin/skill-audit.mjs", "bin/standards.mjs", "bin/standards-gen.mjs", "bin/docs-gen.mjs", "bin/design-check.mjs", "bin/design-scan.mjs", "bin/reuse-adherence.mjs"], "responsibilities": ["Skill/规范/文档/设计产物生成与校验"], "depends_on": ["contracts", "state"] },
    { "id": "supervision", "name": "监督与合规", "layer": "supervision", "paths": ["bin/supervisor.mjs", "bin/domain-supervisors.mjs", "bin/constitution-compliance.mjs", "bin/review.mjs", "bin/scan-anti-patterns.mjs", "bin/scan-ui-anti-patterns.mjs", "bin/scan-secrets.mjs"], "responsibilities": ["diff 审查/域规则/宪法合规/扫描"], "depends_on": ["contracts", "assets"] },
