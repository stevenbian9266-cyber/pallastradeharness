{
  "schemaVersion": "1.0",
  "type": "TemplateRegistry",
  "$comment": "Template Registry 单一事实源（Batch B B02/B03）。source_path / contract_path 相对包根；校验见 bin/template-registry.mjs#validateTemplateRegistry。禁止用手工发现替代本文件。",
  "templates": [
    {
      "template_id": "task-prd",
      "version": "1.0.0",
      "category": "product",
      "scope": "task",
      "source_path": "templates/prd/_TEMPLATE.md",
      "applies_to": ["feature"],
      "required_when": "feature 任务需要 PRD 工作流（v1.4.0 起所有项目 feature gate 内置 PRD 检查）",
      "owner_role": "product_manager",
      "consumed_by": ["harness prd new", "prd verify", "ac-trace"],
      "stale_when": ["product_scope_change", "user_confirmed_prd_revised"],
      "status": "active"
    },
    {
      "template_id": "task-tech-design",
      "version": "1.0.0",
      "category": "task",
      "scope": "runtime",
      "source_path": "templates/designs/tech-design.md",
      "applies_to": ["feature"],
      "required_when": "feature 任务进入设计阶段（designStage.enabled），需要现状识别 + 复用决策矩阵 + 实施落点",
      "owner_role": "tech_lead",
      "consumed_by": ["design-check", "reuse-adherence", "context_audit", "implementation_plan"],
      "stale_when": ["task_scope_change", "architecture_change", "tech_stack_change"],
      "status": "active"
    },
    {
      "template_id": "task-interaction-design",
      "version": "1.0.0",
      "category": "design",
      "scope": "task",
      "source_path": "templates/designs/interaction.md",
      "applies_to": ["feature"],
      "required_when": "任务包含用户交互面（或需显式声明不适用）",
      "owner_role": "ux_designer",
      "consumed_by": ["design-check", "design-confirmed"],
      "stale_when": ["interaction_change", "ui_scope_change"],
      "status": "active"
    },
    {
      "template_id": "task-ui-design",
      "version": "1.0.0",
      "category": "design",
      "scope": "task",
      "source_path": "templates/designs/ui.md",
      "applies_to": ["feature"],
      "required_when": "任务包含界面产出（或需显式声明不适用）",
      "owner_role": "ui_designer",
      "consumed_by": ["design-check", "design-confirmed"],
      "stale_when": ["ui_spec_change", "component_library_change"],
      "status": "active"
    },
    {
      "template_id": "task-visual-design",
      "version": "1.0.0",
      "category": "design",
      "scope": "task",
      "source_path": "templates/designs/visual.md",
      "applies_to": ["feature"],
      "required_when": "任务包含视觉产出（或需显式声明不适用）",
      "owner_role": "ui_designer",
      "consumed_by": ["design-check", "visual-regression", "design-confirmed"],
      "stale_when": ["design_token_change", "visual_baseline_change"],
      "status": "active"
    },
    {
      "template_id": "skill-template",
      "version": "1.0.0",
      "category": "agent",
      "scope": "domain",
      "source_path": "templates/skill/SKILL.md",
      "applies_to": ["skill"],
      "required_when": "生成领域 Skill 且无专属内容模板时（canonical 规范结构，含 14 段治理结构）",
      "owner_role": "knowledge_owner",
      "consumed_by": ["harness skill new", "harness skill check", "harness skill audit"],
      "stale_when": ["constitution_change", "authority_files_change"],
      "status": "active"
    },
    {
      "template_id": "skill-domain-api",
      "version": "1.0.0",
      "category": "agent",
      "scope": "domain",
      "source_path": "presets/skills/api.md",
      "applies_to": ["skill"],
      "required_when": "skill audit 检测到 API/接口领域（目录/文件 glob/关键词命中）",
      "owner_role": "knowledge_owner",
      "consumed_by": ["harness skill new", "harness skill audit --generate"],
      "stale_when": ["authority_files_change", "domain_convention_change"],
      "status": "active"
    },
    {
      "template_id": "skill-domain-data-model",
      "version": "1.0.0",
      "category": "agent",
      "scope": "domain",
      "source_path": "presets/skills/data-model.md",
      "applies_to": ["skill"],
      "required_when": "skill audit 检测到数据模型/持久化领域",
      "owner_role": "knowledge_owner",
      "consumed_by": ["harness skill new", "harness skill audit --generate"],
      "stale_when": ["authority_files_change", "domain_convention_change"],
      "status": "active"
    },
    {
      "template_id": "skill-domain-payment",
