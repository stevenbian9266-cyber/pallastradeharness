      "owner_role": "knowledge_owner",
      "consumed_by": ["harness skill new", "harness skill audit --generate"],
      "stale_when": ["authority_files_change", "domain_convention_change"],
      "status": "active"
    },
    {
      "template_id": "skill-domain-security",
      "version": "1.0.0",
      "category": "agent",
      "scope": "domain",
      "source_path": "presets/skills/security.md",
      "applies_to": ["skill"],
      "required_when": "skill audit 检测到安全领域",
      "owner_role": "knowledge_owner",
      "consumed_by": ["harness skill new", "harness skill audit --generate"],
      "stale_when": ["authority_files_change", "domain_convention_change"],
      "status": "active"
    },
    {
      "template_id": "skill-domain-deployment",
      "version": "1.0.0",
      "category": "agent",
      "scope": "domain",
      "source_path": "presets/skills/deployment.md",
      "applies_to": ["skill"],
      "required_when": "skill audit 检测到部署领域",
      "owner_role": "knowledge_owner",
      "consumed_by": ["harness skill new", "harness skill audit --generate"],
      "stale_when": ["authority_files_change", "domain_convention_change"],
      "status": "active"
    },
    {
      "template_id": "skill-domain-testing",
      "version": "1.0.0",
      "category": "agent",
      "scope": "domain",
      "source_path": "presets/skills/testing.md",
      "applies_to": ["skill"],
      "required_when": "skill audit 检测到测试领域（test 是 Constitution §testing 的权威内容源之一）",
      "owner_role": "knowledge_owner",
      "consumed_by": ["harness skill new", "harness skill audit --generate"],
      "stale_when": ["authority_files_change", "domain_convention_change"],
      "status": "active"
    },
    {
      "template_id": "skill-domain-frontend-style",
      "version": "1.0.0",
      "category": "agent",
      "scope": "domain",
      "source_path": "presets/skills/frontend-style.md",
      "applies_to": ["skill"],
      "required_when": "skill audit 检测到前端样式领域",
      "owner_role": "knowledge_owner",
      "consumed_by": ["harness skill new", "harness skill audit --generate"],
      "stale_when": ["authority_files_change", "domain_convention_change"],
      "status": "active"
    },
    {
      "template_id": "skill-domain-i18n",
      "version": "1.0.0",
      "category": "agent",
      "scope": "domain",
      "source_path": "presets/skills/i18n.md",
      "applies_to": ["skill"],
      "required_when": "skill audit 检测到国际化领域",
      "owner_role": "knowledge_owner",
      "consumed_by": ["harness skill new", "harness skill audit --generate"],
      "stale_when": ["authority_files_change", "domain_convention_change"],
      "status": "active"
    },
    {
      "template_id": "skill-domain-events",
      "version": "1.0.0",
      "category": "agent",
      "scope": "domain",
      "source_path": "presets/skills/events.md",
      "applies_to": ["skill"],
      "required_when": "skill audit 检测到事件/消息领域",
      "owner_role": "knowledge_owner",
      "consumed_by": ["harness skill new", "harness skill audit --generate"],
      "stale_when": ["authority_files_change", "domain_convention_change"],
      "status": "active"
    },
    {
      "template_id": "skill-domain-observability",
      "version": "1.0.0",
      "category": "agent",
      "scope": "domain",
      "source_path": "presets/skills/observability.md",
      "applies_to": ["skill"],
      "required_when": "skill audit 检测到可观测性领域",
      "owner_role": "knowledge_owner",
      "consumed_by": ["harness skill new", "harness skill audit --generate"],
      "stale_when": ["authority_files_change", "domain_convention_change"],
      "status": "active"
    },
    {
      "template_id": "skill-domain-performance",
      "version": "1.0.0",
      "category": "agent",
      "scope": "domain",
      "source_path": "presets/skills/performance.md",
      "applies_to": ["skill"],
      "required_when": "skill audit 检测到性能领域",
      "owner_role": "knowledge_owner",
      "consumed_by": ["harness skill new", "harness skill audit --generate"],
      "stale_when": ["authority_files_change", "domain_convention_change"],
      "status": "active"
    },
    {
      "template_id": "ops-ai-hooks",
      "version": "1.0.0",
      "category": "operations",
      "scope": "project",
      "source_path": "templates/ai-hooks/hooks.json",
      "applies_to": ["install"],
      "required_when": "onboard/init 安装 AI 行为级安全钩子（危险命令拦截 / 密钥警告）",
      "owner_role": "operations_owner",
      "consumed_by": ["harness onboard --write", "harness setup", "harness hooks doctor"],
      "stale_when": ["hook_protocol_change", "agent_adapter_change"],
      "status": "active"
    },
    {
      "template_id": "ops-lefthook",
      "version": "1.0.0",
      "category": "operations",
      "scope": "project",
      "source_path": "templates/lefthook.yml",
      "applies_to": ["install"],
      "required_when": "onboard --write 生成提交拦截（pre-commit 门禁）",
      "owner_role": "operations_owner",
      "consumed_by": ["harness onboard --write", "harness setup"],
      "stale_when": ["hook_tooling_change"],
      "status": "active"
    },
    {
      "template_id": "project-overview",
      "version": "1.0.0",
      "category": "project",
      "scope": "project",
      "source_path": "templates/constitution/project-overview.md",
      "applies_to": ["project"],
      "required_when": "项目 Constitution 初始化（Project Initialization）；Task 理解与 PRD 起草的项目上下文",
      "owner_role": "product_manager",
      "consumed_by": ["project_init", "task_understanding", "prd", "knowledge_update"],
      "stale_when": ["business_scope_change", "target_users_change"],
      "status": "active"
    },
    {
      "template_id": "tech-stack",
      "version": "1.0.0",
      "category": "architecture",
      "scope": "project",
      "source_path": "templates/constitution/tech-stack.md",
      "contract_path": "templates/constitution/tech-stack.schema.json",
      "applies_to": ["project", "task"],
      "required_when": "项目 Constitution 初始化；任务触发依赖变更 / 技术栈变更（Tech Stack Impact）",
      "owner_role": "tech_lead",
      "consumed_by": ["constitution_load", "task_start", "standards_check"],
      "stale_when": ["dependency_change", "tech_stack_change"],
      "status": "active"
    },
    {
      "template_id": "architecture",
      "version": "1.0.0",
      "category": "architecture",
      "scope": "project",
      "source_path": "templates/constitution/architecture.md",
      "contract_path": "templates/constitution/architecture.schema.json",
      "applies_to": ["project", "task"],
      "required_when": "项目 Constitution 初始化；任务触发架构影响（Architecture Impact）",
      "owner_role": "tech_lead",
      "consumed_by": ["constitution_load", "supervisor", "standards_check"],
      "stale_when": ["architecture_change", "module_boundary_change"],
      "status": "active"
    },
    {
      "template_id": "adr",
      "version": "1.0.0",
      "category": "architecture",
      "scope": "project",
      "source_path": "templates/constitution/adr.md",
      "applies_to": ["project"],
      "required_when": "重大技术/架构/安全决策（TECH_STACK_CHANGE 或 ARCHITECTURE_CHANGE）",
      "owner_role": "tech_lead",
      "consumed_by": ["record_decision", "change_proposal"],
      "stale_when": ["superseded_by_new_decision", "constitution_change"],
      "status": "active"
    },
    {
      "template_id": "engineering-standard",
      "version": "1.0.0",
      "category": "engineering",
      "scope": "project",
      "source_path": "templates/constitution/engineering-standard.md",
      "applies_to": ["project", "task"],
      "required_when": "项目 Constitution 初始化；编码/目录/依赖治理（与 base-standards.json 机器规则分工）",
      "owner_role": "tech_lead",
      "consumed_by": ["constitution_load", "supervisor", "standards_check"],
      "stale_when": ["coding_policy_change", "directory_rules_change"],
      "status": "active"
    },
    {
      "template_id": "testing-standard",
      "version": "1.0.0",
      "category": "quality",
      "scope": "project",
      "source_path": "templates/constitution/testing-standard.md",
      "applies_to": ["project", "task"],
      "required_when": "项目 Constitution 初始化；测试策略与证据要求（内容权威源 = presets/skills/testing.md，避免两份冲突真相）",
      "owner_role": "quality_owner",
      "consumed_by": ["constitution_load", "runtime_validation", "evidence_requirements"],
      "stale_when": ["test_strategy_change", "evidence_policy_change"],
      "status": "active"
    },
    {
      "template_id": "acceptance-standard",
      "version": "1.0.0",
      "category": "quality",
      "scope": "project",
      "source_path": "templates/constitution/acceptance-standard.md",
      "applies_to": ["project", "task"],
      "required_when": "项目 Constitution 初始化；定义完成与验收（finish_task 消费）",
      "owner_role": "quality_owner",
      "consumed_by": ["finish_task", "acceptance_review"],
      "stale_when": ["dod_change", "waiver_policy_change"],
      "status": "active"
    },
    {
      "template_id": "agent-rules",
      "version": "1.0.0",
      "category": "agent",
      "scope": "project",
      "source_path": "templates/constitution/agent-rules.md",
      "applies_to": ["agent", "project"],
      "required_when": "项目 Constitution 初始化；Agent 执行约束（Task Entry → Finish Rule）",
      "owner_role": "tech_lead",
      "consumed_by": ["context_audit", "task_execution", "implementation_gate"],
      "stale_when": ["agent_policy_change", "constitution_change"],
      "status": "active"
    }
  ]
}
